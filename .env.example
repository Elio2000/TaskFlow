# Read only by the local DeepSeek adapter. Never commit the real value.
DEEPSEEK_API_KEY=

# Codex SDK -> CC Switch local Responses route -> DeepSeek Chat Completions
AI_PROVIDER=codex_sdk
AI_PLANNER_MODEL=deepseek-v4-pro
AI_PLANNER_THINKING=disabled
AI_PLANNER_REASONING_EFFORT=high
AI_PLANNER_TEMPERATURE=0.35
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_PLANNER_MAX_TOKENS=8192
AI_PLANNER_TIMEOUT_SECONDS=180
AI_PLANNER_IDLE_TIMEOUT_SECONDS=60
AI_PLANNER_FIRST_REPLY_TIMEOUT_SECONDS=25
# Keep true in normal networks. Set false only if your local Python cannot verify
# the DeepSeek HTTPS certificate chain in a trusted development environment.
AI_PLANNER_SSL_VERIFY=true

# Web server
HOST=0.0.0.0
PORT=5055

# Local task attachments
AI_PLANNER_ATTACHMENT_DIR=data/attachments
AI_PLANNER_MAX_ATTACHMENT_BYTES=5242880
